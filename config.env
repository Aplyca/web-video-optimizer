# config.env — defaults for every video processed in this project.
#
# Per-video overrides: drop <video>.env next to the video in inbox/ (e.g.
# clip.mov.env) before it is picked up, or edit videos/<job>/job.env afterwards
# (a commented template is created for each job). One-off overrides:
# environment variables, e.g. VMAF=off ./optimize.sh
# Precedence: built-in defaults < config.env < job.env < environment.
# Format is KEY=VALUE; this file is parsed, never executed.

# --- Quality ----------------------------------------------------------------
# CRF (x264 constant quality): lower = better quality and bigger file, 1-51.
# auto: try CRFS from highest to lowest and deliver the first (smallest) encode
#       whose VMAF score reaches VMAF_TARGET. A number: always use that CRF.
CRF_FINAL=auto
CRFS="20 22 24 26 28 30 32 34"
# Used when CRF_FINAL=auto but VMAF=off, since there is no score to search with
CRF_FALLBACK=26

# VMAF: Netflix's perceptual quality score, 0-100. 90+ is visually transparent
# for most viewers. Measuring takes roughly the video's duration per candidate.
VMAF=on
VMAF_TARGET=90

# --- Picture ----------------------------------------------------------------
# Longest side in pixels (1920 = 1080p landscape, 1080x1920 portrait). Never upscales.
MAX_DIMENSION=1920
# auto: keep the source frame rate unless it exceeds MAX_FPS.
# keep: always keep it. A number (e.g. 24): cap to that rate.
# Muted background/hero loops usually look fine at FPS=24.
FPS=auto
MAX_FPS=30

# --- Audio ------------------------------------------------------------------
# keep: re-encode to AAC (surround is downmixed to stereo). strip: remove it,
# e.g. for muted autoplay background videos.
AUDIO=keep
AUDIO_BITRATE=128k
# auto: downmix surround to stereo, leave mono/stereo as is. mono: speech-only
# content (use with AUDIO_BITRATE=96k). stereo: always two channels.
AUDIO_CHANNELS=auto

# --- Encoder ----------------------------------------------------------------
# Slower presets give smaller files at the same quality.
X264_PRESET=slow
# Content tuning: none | film (live action) | animation (flat colors, motion
# graphics, UI) | grain (keep film grain) | stillimage (slides). A wrong tune is
# worse than none, so set it per video.
X264_TUNE=none
# Cap the peak video bitrate for strict size or bandwidth budgets, e.g. 900k or
# 3M; none = no cap. A cap can keep encodes below VMAF_TARGET (reported).
MAX_BITRATE=none
# Seconds into the video for the poster frame (clamped to half the duration)
POSTER_TIME=1

# --- Toolchain (config.env / environment only) --------------------------------
# Every ffmpeg, ffprobe, VMAF and download step runs inside this Docker image;
# nothing is installed on the host. Pulled automatically on first run.
# Pinned for reproducible results; the image ID is part of every cache key.
FFMPEG_IMAGE=linuxserver/ffmpeg:9.0-cli-ls81
# Seconds between inbox checks in --watch mode
WATCH_INTERVAL=10
# A file in inbox/ is only picked up once it hasn't changed for this many
# seconds, so copies in progress aren't processed half-written. For slow or
# stalling transfers, copy under a temporary name (e.g. video.mp4.part) and
# rename when done: .part/.crdownload/.download/.tmp files are always skipped.
INBOX_SETTLE=10
